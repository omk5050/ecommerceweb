# ==============================================================================
# EARTHFORM — ENVIRONMENT CONFIGURATION (EXAMPLE / TEMPLATE)
# ==============================================================================
# Copy this file to .env (or backend/.env) for local development, or add these
# environment variables directly into the Render Web Service Environment dashboard.
# NEVER commit real credentials or production secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION (Render / Express)
# ------------------------------------------------------------------------------
# In production on Render, PORT is assigned dynamically by Render.
# Do NOT hardcode PORT on Render. Locally, it defaults to 5000.
PORT=5000
NODE_ENV=production

# Optional: URL of frontend if hosted separately or for specific CORS whitelisting
# For single-service Render deployment, leave blank or set to your Render URL.
FRONTEND_URL=https://your-service-name.onrender.com

# ------------------------------------------------------------------------------
# 2. FRONTEND PUBLIC VARIABLES (Safe for browser / Client-side)
# ------------------------------------------------------------------------------
# Optional: In production on a single Render service, leave unset or empty to use
# same-origin relative URLs (/api). For local separate dev (frontend: 3000, backend: 5000),
# it defaults automatically to http://localhost:5000.
# NEXT_PUBLIC_API_URL=

# ------------------------------------------------------------------------------
# 3. BACKEND SECRETS (SERVER-ONLY — NEVER expose as NEXT_PUBLIC_*)
# ------------------------------------------------------------------------------

# MongoDB Atlas Database Connection String (Required for product & admin data)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=

# Cloudinary Storage Configuration (Required for product image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Authentication Secrets (Required for Admin JWT authentication)
# Generate a secure 64-char random hex string via:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Administrator Initial Seed Credentials (Used ONLY when running seed:admin)
# Seed the initial admin via Render Shell: npm run seed:admin:prod
ADMIN_SEED_NAME=Earthform Admin
ADMIN_SEED_EMAIL=admin@your-domain.com
ADMIN_SEED_PASSWORD=your-secure-admin-password-min-8-chars

# ------------------------------------------------------------------------------
# 4. LEGACY / SECONDARY CONFIGURATION
# ------------------------------------------------------------------------------
# MySQL Database (if utilized)
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=earthform
