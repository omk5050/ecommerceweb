# Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:3000

# MongoDB Atlas Configuration
# Note: Provide your MongoDB Atlas connection string here
MONGODB_URI=

# Cloudinary Configuration (Prepared for image upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Authentication
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Admin Seed Credentials (used ONLY by: npm run seed:admin)
# Set strong values before running the seed script. Never commit real credentials.
ADMIN_SEED_NAME=
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
